    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": "prettier --write",
